@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4 Context — ВКР-трекер (MVP)

Person(deputy, "Замзав", "Владелец цикла ВКР; запускает цикл, следит за статусами и просрочками на дашборде")
Person(teacher, "Руководитель ВКР", "Вносит темы в каталог, подаёт пары «студент — тема»")
Person(secretary, "Секретарь кафедры", "Проверяет проект приказа, публикует, фиксирует ответ ректората")
Person(student, "Студент", "Добавляет источники через рефчекер, видит свои сроки")
Person(reviewer, "Рецензент", "Выставляет оценку и комментарий за просмотр в окне")

System(vkr, "ВКР-трекер", "Окна регламента, статусы этапов, напоминания, каталог тем, сборка проекта приказа, рефчекер ГОСТ")

System_Ext(meta, "Внешние базы метаданных", "Crossref, eLIBRARY, каталоги библиотек — метаданные по DOI/ISBN/URL")
System_Ext(channels, "Каналы уведомлений", "Email и мессенджер — туда, где человек уже живёт")

Rel(deputy, vkr, "Запускает цикл, смотрит дашборд, продлевает окна")
Rel(teacher, vkr, "Вносит темы, подаёт пары")
Rel(secretary, vkr, "Проверяет и публикует приказ")
Rel(student, vkr, "Добавляет источники, следит за сроками")
Rel(reviewer, vkr, "Выставляет оценки просмотров")
Rel(vkr, meta, "Запрашивает метаданные источников", "HTTPS")
Rel(vkr, channels, "Отправляет напоминания", "SMTP / Bot API")

SHOW_LEGEND()
@enduml