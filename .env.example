MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512
# For an explicitly selected cheaper model: ministral-3b-2512.
AI_DB_PATH=var/ai.sqlite3
AI_PROFILE_PATH=docs/experiments/profiles.example.json
# langfuse is required for acceptance. local is only an explicit development mode.
AI_TRACING_MODE=langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Enable only on synthetic/redacted profiles to see prompts and answers in dashboard.
AI_TRACE_CONTENT=true
AI_TRACE_PATH=var/llm-calls.jsonl

# v1 (control), v2 (full context), v2-compact (pilot with short context).
AI_PROMPT_VARIANT=v1
AI_CACHE_TTL_SECONDS=0
AI_HISTORY_TOOL=false
